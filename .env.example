# From @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Comma-separated. These accounts are owners regardless of what the database
# says — a bad restore must never lock you out of your own bot.
BOT_OWNER_IDS=123456789

# sqlite for development; postgresql+asyncpg://user:pass@host/db in production
BOT_DATABASE_URL=sqlite+aiosqlite:///botkit.db

# Without Redis, every in-progress form is lost on restart.
BOT_REDIS_URL=redis://localhost:6379/0

BOT_DEFAULT_LOCALE=en
BOT_THROTTLE_LIMIT=5
BOT_THROTTLE_WINDOW=2.0
BOT_LOG_LEVEL=INFO
